{
  "manifest_version": 1,
  "id": "dev.plisto.vis-level-glow",
  "name": "Level glow",
  "version": "1.0.0",
  "tier": "ui",
  "capabilities": ["visualizer"],
  "min_plisto": "2.8.0",
  "author": "Plisto",
  "visualizers": [
    {
      "id": "level-glow",
      "name": "Level glow",
      "api": 1,
      "shader": "vis/glow.frag",
      "look": "glow",
      "settings": [
        { "id": "tint", "label": "Tint", "type": "color", "default": "cover" },
        { "id": "reach", "label": "Reach", "type": "range", "min": 0.5, "max": 1.5, "step": 0.1, "default": 1 }
      ],
      "presets": [
        { "id": "cool", "label": "Cool", "values": { "tint": "#3a6ea5", "reach": 1.2 } }
      ]
    }
  ]
}
